{
    "name": "@supernova/wine-api",
    "version": "2.0.0",
    "description": "VXT WiNE API",
    "main": "dist/index.umd.js",
    "types": "dist/index.d.ts",
    "module": "dist/index.es.js",
    "license": "Samsung",
    "files": [
        "dist"
    ],
    "volta": {
        "node": "24.3.0",
        "yarn": "1.22.11"
    },
    "prettier": "@supernova/prettier-config",
    "dependencies": {
        "broadcast-channel": "^7.1.0"
    },
    "devDependencies": {
        "@babel/preset-typescript": "^7.27.1",
        "@types/node": "^24.3.0",
        "esbuild-loader": "^2.15.1",
        "typescript": "^5.9.2",
        "vitest": "^3.2.4",
        "webpack": "^5.102.0",
        "webpack-cli": "^6.0.1"
    },
    "scripts": {
        "clean": "rimraf dist *.tsbuildinfo",
        "build:umd": "webpack --mode=production --env library=umd",
        "build:es": "webpack --mode=development --env library=es",
        "build": "yarn run clean && yarn run build:es && yarn run build:umd && tsc",
        "test": "vitest --run"
    }
